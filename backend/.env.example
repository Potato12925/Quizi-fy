# Database & Storage (Supabase)
SUPABASE_PASS=your_supabase_db_password
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN_MINUTES=60

# AI Configuration (OpenAI)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Background Tasks & Queue (Celery & Redis)
CELERY_BROKER_URL=rediss://default:password@your-redis-host:port/0
CELERY_RESULT_BACKEND=rediss://default:password@your-redis-host:port/0
