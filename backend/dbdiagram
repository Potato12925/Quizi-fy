Enum active_status {
  active
  inactive
}

Enum ai_request_status {
  pending
  processing
  completed
  failed
  cancelled
}

Enum difficulty_level {
  recognition
  comprehension
  application
  advanced
}

Enum practice_attempt_status {
  in_progress
  submitted
  timeout
}

Enum question_source {
  ai
  manual
}

Enum question_status {
  draft
  approved
  inactive
  rejected
}

Table users {
  user_id bigint [pk]
  username varchar [not null, unique]
  password_hash varchar [not null]
  full_name varchar [not null]
  is_active boolean [default: true]
  must_change_password boolean [default: true]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table roles {
  role_id bigint [pk]
  role_code varchar [not null, unique]
  role_name varchar [not null]
  description text
  created_at timestamp
}

Table user_roles {
  user_role_id bigint [pk]
  user_id bigint [not null]
  role_id bigint [not null]
  assigned_at timestamp
}

Table classes {
  class_id bigint [pk]
  class_code varchar [not null, unique]
  class_name varchar [not null]
  description text
  teacher_id bigint [not null]
  status active_status
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table subjects {
  subject_id bigint [pk]
  subject_code varchar [not null, unique]
  subject_name varchar [not null]
  description text
  status active_status
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table class_teachers {
  class_teacher_id bigint [pk]
  class_id bigint [not null]
  teacher_id bigint [not null]
  joined_at timestamp
  deleted_at timestamp
}

Table class_students {
  class_student_id bigint [pk]
  class_id bigint [not null]
  student_id bigint [not null]
  joined_at timestamp
  deleted_at timestamp
}

Table class_subjects {
  class_subject_id bigint [pk]
  class_id bigint [not null]
  subject_id bigint [not null]
  assigned_teacher_id bigint
  status active_status
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table topics {
  topic_id bigint [pk]
  topic_name varchar [not null]
  description text
  class_subject_id bigint
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table documents {
  document_id bigint [pk]
  teacher_id bigint [not null]
  title varchar [not null]
  description text
  file_url text [not null]
  file_hash varchar
  file_type varchar [not null]
  file_size bigint [not null]
  status active_status
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table document_topics {
  document_topic_id bigint [pk]
  document_id bigint [not null]
  topic_id bigint [not null]
  created_at timestamp
  deleted_at timestamp
}

Table document_chunks {
  chunk_id bigint [pk]
  document_id bigint [not null]
  chunk_index int [not null]
  chunk_title text
  chunk_text text [not null]
  embedding text [note: 'pgvector vector(1536) in SQL schema']
  chunk_hash varchar
  start_char int
  end_char int
  page_from int
  page_to int
  token_count int
  created_at timestamp
  deleted_at timestamp

  indexes {
    document_id
    chunk_hash
    (document_id, chunk_index) [name: 'uq_document_chunks_document_chunk_index_active']
  }
}

Table ai_requests {
  request_id bigint [pk]
  document_topic_id bigint [not null]
  num_questions int [not null]
  content_scope text
  status ai_request_status
  generated_question_count int
  retry_count int
  error_message text
  is_reviewed boolean [default: false]
  created_at timestamp
  updated_at timestamp
}

Table ai_request_difficulty_distribution {
  distribution_id bigint [pk]
  request_id bigint [not null]
  difficulty difficulty_level [not null]
  percentage int
  question_count int [not null]
  created_at timestamp

  indexes {
    (request_id, difficulty) [unique]
  }
}

Table questions {
  question_id bigint [pk]
  teacher_id bigint [not null]
  topic_id bigint [not null]
  ai_request_id bigint
  content text [not null]
  difficulty difficulty_level [not null]
  source question_source [not null]
  status question_status
  explanation text
  image_id bigint
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table question_options {
  option_id bigint [pk]
  question_id bigint [not null]
  option_label varchar [not null]
  option_text text [not null]
  is_correct boolean
  order_num int [not null]
}

Table question_sources {
  question_source_id bigint [pk]
  question_id bigint [not null]
  chunk_id bigint [not null]
  relevance_score numeric
  created_at timestamp

  indexes {
    question_id
    chunk_id
    (question_id, chunk_id) [unique]
  }
}

Table question_history {
  history_id bigint [pk]
  question_id bigint [not null]
  changed_by bigint [not null]
  old_data jsonb
  new_data jsonb
  change_type varchar
  changed_at timestamp
}

Table practice_sets {
  practice_set_id bigint [pk]
  student_id bigint [not null]
  subject_id bigint [not null]
  topic_id bigint
  difficulty difficulty_level
  num_questions_requested int [not null]
  num_questions_actual int
  time_limit_minutes int
  prioritize_unanswered boolean
  created_at timestamp
  deleted_at timestamp
}

Table practice_set_questions {
  practice_set_question_id bigint [pk]
  practice_set_id bigint [not null]
  question_id bigint [not null]
  order_num int [not null]
}

Table practice_attempts {
  attempt_id bigint [pk]
  practice_set_id bigint [not null]
  started_at timestamp
  submitted_at timestamp
  score numeric
  total_correct int
  total_wrong int
  status practice_attempt_status
  deleted_at timestamp
}

Table student_answers {
  answer_id bigint [pk]
  attempt_id bigint [not null]
  question_id bigint [not null]
  selected_option_id bigint
  is_correct boolean
  answered_at timestamp
  deleted_at timestamp
}

Table notifications {
  notification_id bigint [pk]
  user_id bigint [not null]
  title varchar
  content text
  is_read boolean
  created_at timestamp
}

Table image_types {
  image_type_id bigint [pk]
  type_code varchar [not null, unique]
  type_name varchar [not null]
  description text
  created_at timestamp
}

Table images {
  image_id bigint [pk]
  image_type_id bigint [not null]
  uploaded_by bigint
  file_name varchar
  file_url text [not null]
  file_hash varchar
  file_size bigint
  mime_type varchar
  created_at timestamp
  deleted_at timestamp
}

Table student_ai_chat_messages {
  id bigint [pk]
  student_id bigint [not null]
  role varchar [not null]
  content text [not null]
  tools_used jsonb
  cached boolean [default: false]
  created_at timestamp
  deleted_at timestamp
}

Ref: user_roles.user_id > users.user_id
Ref: user_roles.role_id > roles.role_id

Ref: classes.teacher_id > users.user_id

Ref: class_teachers.class_id > classes.class_id
Ref: class_teachers.teacher_id > users.user_id

Ref: class_students.class_id > classes.class_id
Ref: class_students.student_id > users.user_id

Ref: class_subjects.class_id > classes.class_id
Ref: class_subjects.subject_id > subjects.subject_id
Ref: class_subjects.assigned_teacher_id > users.user_id

Ref: topics.class_subject_id > class_subjects.class_subject_id

Ref: documents.teacher_id > users.user_id

Ref: document_topics.document_id > documents.document_id
Ref: document_topics.topic_id > topics.topic_id
Ref: document_chunks.document_id > documents.document_id

Ref: ai_requests.document_topic_id > document_topics.document_topic_id
Ref: ai_request_difficulty_distribution.request_id > ai_requests.request_id

Ref: questions.teacher_id > users.user_id
Ref: questions.topic_id > topics.topic_id
Ref: questions.ai_request_id > ai_requests.request_id

Ref: question_options.question_id > questions.question_id
Ref: question_sources.question_id > questions.question_id
Ref: question_sources.chunk_id > document_chunks.chunk_id

Ref: question_history.question_id > questions.question_id
Ref: question_history.changed_by > users.user_id

Ref: practice_sets.student_id > users.user_id
Ref: practice_sets.subject_id > subjects.subject_id
Ref: practice_sets.topic_id > topics.topic_id

Ref: practice_set_questions.practice_set_id > practice_sets.practice_set_id
Ref: practice_set_questions.question_id > questions.question_id

Ref: practice_attempts.practice_set_id > practice_sets.practice_set_id

Ref: student_answers.attempt_id > practice_attempts.attempt_id
Ref: student_answers.question_id > questions.question_id
Ref: student_answers.selected_option_id > question_options.option_id

Ref: notifications.user_id > users.user_id

Ref: images.image_type_id > image_types.image_type_id
Ref: images.uploaded_by > users.user_id
Ref: questions.image_id > images.image_id

Ref: student_ai_chat_messages.student_id > users.user_id
