Enum active_status {
  active
  inactive
}

Enum difficulty_level {
  easy
  medium
  hard
}

Enum ai_request_status {
  pending
  processing
  completed
  failed
  cancelled
}

Enum question_source {
  ai
  manual
}

Enum question_status {
  draft
  approved
  inactive
  rejected
}

Enum practice_attempt_status {
  in_progress
  submitted
  timeout
}

Table users {
  user_id bigint [pk, increment]
  username varchar(100) [unique, not null]
  password_hash varchar(255) [not null]
  full_name varchar(255) [not null]
  is_active boolean [default: true]
  must_change_password boolean [default: true]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  deleted_at timestamp
}

Table roles {
  role_id bigint [pk, increment]
  role_code varchar(50) [unique, not null]
  role_name varchar(100) [not null]
  description text
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
}

Table user_roles {
  user_role_id bigint [pk, increment]
  user_id bigint [not null]
  role_id bigint [not null]
  assigned_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (user_id, role_id) [unique, name: "uq_user_role"]
  }
}

Table classes {
  class_id bigint [pk, increment]
  class_code varchar(50) [unique, not null]
  class_name varchar(255) [not null]
  description text
  teacher_id bigint [not null]
  status active_status [default: 'active']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  deleted_at timestamp
}

Table subjects {
  subject_id bigint [pk, increment]
  subject_code varchar(50) [unique, not null]
  subject_name varchar(255) [not null]
  description text
  status active_status [default: 'active']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  deleted_at timestamp
}

Table topics {
  topic_id bigint [pk, increment]
  subject_id bigint [not null]
  topic_name varchar(255) [not null]
  description text
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  deleted_at timestamp

  indexes {
    (subject_id, topic_name) [unique, name: "uq_topic_subject"]
  }
}

Table class_teachers {
  class_teacher_id bigint [pk, increment]
  class_id bigint [not null]
  teacher_id bigint [not null]
  joined_at timestamp [default: `CURRENT_TIMESTAMP`]
  deleted_at timestamp

  indexes {
    (class_id, teacher_id) [unique, name: "uq_class_teacher"]
  }
}

Table class_subjects {
  class_subject_id bigint [pk, increment]
  class_id bigint [not null]
  subject_id bigint [not null]
  assigned_teacher_id bigint
  status active_status [default: 'active']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  deleted_at timestamp

  indexes {
    (class_id, subject_id) [unique, name: "uq_class_subject"]
  }
}

Table class_students {
  class_student_id bigint [pk, increment]
  class_id bigint [not null]
  student_id bigint [not null]
  joined_at timestamp [default: `CURRENT_TIMESTAMP`]
  deleted_at timestamp

  indexes {
    (class_id, student_id) [unique, name: "uq_class_student"]
  }
}

Table documents {
  document_id bigint [pk, increment]
  teacher_id bigint [not null]
  title varchar(500) [not null]
  description text
  file_url text [not null]
  file_hash varchar(255)
  file_type varchar(20) [not null]
  file_size bigint [not null]
  status active_status [default: 'active']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  deleted_at timestamp
}

Table document_topics {
  document_topic_id bigint [pk, increment]
  document_id bigint [not null]
  topic_id bigint [not null]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (document_id, topic_id) [unique, name: "uq_document_topic"]
  }
}

Table ai_requests {
  request_id bigint [pk, increment]
  document_topic_id bigint [not null]
  num_questions int [not null]
  difficulty difficulty_level [not null]
  content_scope text
  status ai_request_status [default: 'pending']
  generated_question_count int [default: 0]
  retry_count int [default: 0]
  error_message text
  is_reviewed boolean [default: false]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
}

Table questions {
  question_id bigint [pk, increment]
  teacher_id bigint [not null]
  document_topic_id bigint [not null]
  ai_request_id bigint
  content text [not null]
  difficulty difficulty_level [not null]
  source question_source [not null]
  status question_status [default: 'draft']
  explanation text
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  deleted_at timestamp
}

Table question_options {
  option_id bigint [pk, increment]
  question_id bigint [not null]
  option_label varchar(5) [not null]
  option_text text [not null]
  is_correct boolean [default: false]
  order_num int [not null]

  indexes {
    (question_id, order_num) [unique, name: "uq_question_option_order"]
  }
}

Table question_history {
  history_id bigint [pk, increment]
  question_id bigint [not null]
  changed_by bigint [not null]
  old_data jsonb
  new_data jsonb
  change_type varchar(100)
  changed_at timestamp [default: `CURRENT_TIMESTAMP`]
}

Table practice_sets {
  practice_set_id bigint [pk, increment]
  student_id bigint [not null]
  subject_id bigint [not null]
  document_topic_id bigint
  difficulty difficulty_level
  num_questions_requested int [not null]
  num_questions_actual int
  time_limit_minutes int
  prioritize_unanswered boolean [default: false]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
}

Table practice_set_questions {
  practice_set_question_id bigint [pk, increment]
  practice_set_id bigint [not null]
  question_id bigint [not null]
  order_num int [not null]

  indexes {
    (practice_set_id, question_id) [unique, name: "uq_psq_question"]
    (practice_set_id, order_num) [unique, name: "uq_psq_order"]
  }
}

Table practice_attempts {
  attempt_id bigint [pk, increment]
  practice_set_id bigint [not null]
  started_at timestamp [default: `CURRENT_TIMESTAMP`]
  submitted_at timestamp
  score decimal(5,2)
  total_correct int [default: 0]
  total_wrong int [default: 0]
  status practice_attempt_status [default: 'in_progress']
}

Table student_answers {
  answer_id bigint [pk, increment]
  attempt_id bigint [not null]
  question_id bigint [not null]
  selected_option_id bigint
  is_correct boolean
  answered_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (attempt_id, question_id) [unique, name: "uq_attempt_question"]
  }
}

Table notifications {
  notification_id bigint [pk, increment]
  user_id bigint [not null]
  title varchar(255)
  content text
  is_read boolean [default: false]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
}

Ref: user_roles.user_id > users.user_id [delete: cascade]
Ref: user_roles.role_id > roles.role_id [delete: cascade]

Ref: classes.teacher_id > users.user_id [delete: cascade]

Ref: topics.subject_id > subjects.subject_id [delete: cascade]

Ref: class_teachers.class_id > classes.class_id [delete: cascade]
Ref: class_teachers.teacher_id > users.user_id [delete: cascade]

Ref: class_subjects.class_id > classes.class_id [delete: cascade]
Ref: class_subjects.subject_id > subjects.subject_id [delete: cascade]
Ref: class_subjects.assigned_teacher_id > users.user_id [delete: set null]

Ref: class_students.class_id > classes.class_id [delete: cascade]
Ref: class_students.student_id > users.user_id [delete: cascade]

Ref: documents.teacher_id > users.user_id [delete: cascade]

Ref: document_topics.document_id > documents.document_id [delete: cascade]
Ref: document_topics.topic_id > topics.topic_id [delete: cascade]

Ref: ai_requests.document_topic_id > document_topics.document_topic_id [delete: cascade]

Ref: questions.teacher_id > users.user_id [delete: cascade]
Ref: questions.document_topic_id > document_topics.document_topic_id [delete: cascade]
Ref: questions.ai_request_id > ai_requests.request_id [delete: set null]

Ref: question_options.question_id > questions.question_id [delete: cascade]

Ref: question_history.question_id > questions.question_id [delete: cascade]
Ref: question_history.changed_by > users.user_id [delete: cascade]

Ref: practice_sets.student_id > users.user_id [delete: cascade]
Ref: practice_sets.subject_id > subjects.subject_id [delete: cascade]
Ref: practice_sets.document_topic_id > document_topics.document_topic_id [delete: set null]

Ref: practice_set_questions.practice_set_id > practice_sets.practice_set_id [delete: cascade]
Ref: practice_set_questions.question_id > questions.question_id [delete: cascade]

Ref: practice_attempts.practice_set_id > practice_sets.practice_set_id [delete: cascade]

Ref: student_answers.attempt_id > practice_attempts.attempt_id [delete: cascade]
Ref: student_answers.question_id > questions.question_id [delete: cascade]
Ref: student_answers.selected_option_id > question_options.option_id [delete: set null]

Ref: notifications.user_id > users.user_id [delete: cascade]
